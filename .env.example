# Public site URL for Open Graph link previews (must match your live domain)
VITE_SITE_URL=https://drevil.coffee

# Shopify Storefront API (optional). When both are set the collection page adds
# configured bags straight to a Shopify cart and sends the customer to checkout.
# When unset it deep-links to the product page on shop.drevil.coffee instead.
# This token is the PUBLIC Storefront token — never put the Admin token here.
VITE_SHOPIFY_DOMAIN=shop.drevil.coffee
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Ad pixels (optional). Both loaders are inert until set. Get the IDs from
# Meta Events Manager → Data sources → Pixel, and TikTok Ads Manager → Assets → Events.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
