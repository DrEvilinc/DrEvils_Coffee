{%- comment -%}
  DR. EVIL'S COFFEE — ROAST & GRIND WORK ORDER
  ============================================
  Shopify Order Printer template (Admin → Settings → Apps → Order Printer →
  Templates → Add template → paste this). Prints a per-line production sheet that
  tells the roaster exactly what to do on the ROEST L200 and the Mahlkönig GH2.

  REQUIREMENTS
   - Each coffee's variant SKU must be its LAB code: LAB-001 … LAB-006.
   - The line item must carry two properties: "Roast Level" (Light/House/Dark
     Roast) and "Grind" (Whole Bean / Espresso / …). These are set automatically
     by the site's cart deep-link and by the product-page snippet.

  KEEP IN SYNC with src/app/data/roasting.ts (House drop temps + GH2 dials).
  These are STARTING numbers — overwrite with your calibrated values.
{%- endcomment -%}

<style>
  .wo { font-family: 'Courier New', monospace; color:#000; }
  .wo h1 { font-size:16px; letter-spacing:2px; border-bottom:2px solid #000; padding-bottom:6px; }
  .wo .li { border:1px solid #000; padding:10px 12px; margin:10px 0; page-break-inside:avoid; }
  .wo .lab { font-size:18px; font-weight:bold; letter-spacing:2px; }
  .wo .row { display:flex; gap:14px; margin-top:6px; }
  .wo .k { font-size:10px; letter-spacing:1px; color:#444; text-transform:uppercase; }
  .wo .v { font-size:13px; font-weight:bold; }
  .wo .band { background:#000; color:#fff; padding:2px 6px; display:inline-block; letter-spacing:1px; }
  .wo .note { font-size:11px; margin-top:6px; }
</style>

<div class="wo">
  <h1>ROAST &amp; GRIND WORK ORDER — {{ order.name }}</h1>
  <div class="note">Ordered {{ order.created_at | date: "%b %-d, %Y %I:%M %p" }} · {{ order.customer.first_name }} {{ order.customer.last_name }}</div>

  {% for line_item in line_items %}
    {%- assign roast = 'House Roast' -%}
    {%- assign grind = 'Whole Bean' -%}
    {%- for p in line_item.properties -%}
      {%- assign key = p.first | downcase -%}
      {%- if key contains 'roast' -%}{%- assign roast = p.last -%}{%- endif -%}
      {%- if key contains 'grind' -%}{%- assign grind = p.last -%}{%- endif -%}
    {%- endfor -%}
    {%- assign sku = line_item.sku | upcase -%}

    {%- comment -%} House drop temp + saved-profile name by SKU {%- endcomment -%}
    {%- case sku -%}
      {%- when 'LAB-001' -%}{%- assign houseC = 209 -%}{%- assign prof = 'LAB-001 Aponte Honey — House' -%}{%- assign fc = '9:00' -%}{%- assign tt = '10:45' -%}
      {%- when 'LAB-002' -%}{%- assign houseC = 207 -%}{%- assign prof = 'LAB-002 Peru Huabal — House' -%}{%- assign fc = '8:45' -%}{%- assign tt = '10:15' -%}
      {%- when 'LAB-003' -%}{%- assign houseC = 204 -%}{%- assign prof = 'LAB-003 Ethiopia Gera — House' -%}{%- assign fc = '8:30' -%}{%- assign tt = '9:45' -%}
      {%- when 'LAB-004' -%}{%- assign houseC = 213 -%}{%- assign prof = 'LAB-004 Yemen Haimi — House' -%}{%- assign fc = '9:15' -%}{%- assign tt = '11:15' -%}
      {%- when 'LAB-005' -%}{%- assign houseC = 203 -%}{%- assign prof = 'LAB-005 Chiroso — House' -%}{%- assign fc = '8:30' -%}{%- assign tt = '9:30' -%}
      {%- when 'LAB-006' -%}{%- assign houseC = 210 -%}{%- assign prof = 'LAB-006 Buesaco — House' -%}{%- assign fc = '9:00' -%}{%- assign tt = '10:45' -%}
      {%- else -%}{%- assign houseC = 0 -%}{%- assign prof = line_item.title -%}{%- assign fc = '—' -%}{%- assign tt = '—' -%}
    {%- endcase -%}

    {%- comment -%} Roast delta from House {%- endcomment -%}
    {%- assign r = roast | downcase -%}
    {%- if r contains 'light' -%}
      {%- assign targetC = houseC | minus: 6 -%}{%- assign action = 'LIGHT — drop ~6°C earlier, cut ~45s sooner (shorter development).' -%}
    {%- elsif r contains 'dark' -%}
      {%- assign targetC = houseC | plus: 6 -%}{%- assign action = 'DARK — extend ~50s, drop ~6°C later (longer development). Watch 2nd crack on X-tier.' -%}
    {%- else -%}
      {%- assign targetC = houseC -%}{%- assign action = 'HOUSE — run saved profile as-is. No change.' -%}
    {%- endif -%}
    {%- assign targetF = targetC | times: 9 | divided_by: 5 | plus: 32 -%}

    {%- comment -%} Grind → GH2 dial {%- endcomment -%}
    {%- assign g = grind | downcase -%}
    {%- if g contains 'whole' -%}{%- assign gh2 = 'WHOLE BEAN — do not grind' -%}
    {%- elsif g contains 'espresso' -%}{%- assign gh2 = 'GH2 · 2 (~250µm)' -%}
    {%- elsif g contains 'moka' -%}{%- assign gh2 = 'GH2 · 4 (~330µm)' -%}
    {%- elsif g contains 'aeropress' -%}{%- assign gh2 = 'GH2 · 6 (~450µm)' -%}
    {%- elsif g contains 'pour' -%}{%- assign gh2 = 'GH2 · 8 (~550µm)' -%}
    {%- elsif g contains 'drip' -%}{%- assign gh2 = 'GH2 · 10 (~700µm)' -%}
    {%- elsif g contains 'chemex' -%}{%- assign gh2 = 'GH2 · 11 (~800µm)' -%}
    {%- elsif g contains 'french' -%}{%- assign gh2 = 'GH2 · 15 (~1000µm)' -%}
    {%- elsif g contains 'cold' -%}{%- assign gh2 = 'GH2 · 17 (~1100µm)' -%}
    {%- else -%}{%- assign gh2 = grind -%}
    {%- endif -%}

    <div class="li">
      <div class="lab">{{ sku }} × {{ line_item.quantity }}</div>
      <div class="note">{{ line_item.title }}</div>

      <div class="row">
        <div><div class="k">Roast</div><div class="v"><span class="band">{{ roast }}</span></div></div>
        <div><div class="k">Grind</div><div class="v">{{ gh2 }}</div></div>
      </div>

      <div class="row">
        <div><div class="k">ROEST profile</div><div class="v">{{ prof }}</div></div>
        <div><div class="k">Target drop</div><div class="v">{{ targetC }}°C / {{ targetF }}°F</div></div>
        <div><div class="k">FC ref</div><div class="v">{{ fc }}</div></div>
        <div><div class="k">Total ref</div><div class="v">{{ tt }}</div></div>
      </div>

      <div class="note">▶ {{ action }}</div>
    </div>
  {% endfor %}

  <div class="note">Freshness card auto-included in package. Whole bean keeps longest — customer grinds fresh.</div>
</div>
