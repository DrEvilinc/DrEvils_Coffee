{%- comment -%}
  Dr. Evil's Coffee — grind picker + deep-link handshake for shop.drevil.coffee.

  The Vercel site (drevil.coffee/collection) lets the customer configure a lot,
  then sends them here as:
      /products/<handle>?roast=Full%20Charge&size=12%20oz&grind=Medium&brew=Drip%20%2F%20Auto%20Brewer

  This snippet:
    1. Adds the GRIND radio group (line-item property "Grind") + hidden
       "Brew Method" property.  Grind is a fulfillment instruction, not a
       variant — see the site's src/app/data/roastGrind.ts.
    2. Honours ?grind= and ?brew= by pre-selecting / pre-filling them.
    3. Honours ?roast= and ?size=. Catalog option A (locked 2026-09-10) is
       Option "Roast" (Low Voltage / Full Charge / Maximum Overdrive) x
       Option "Bag Size" (8 oz / 12 oz / 1 lb / 2 lbs). The script swaps the
       page to the variant that matches both; if ?size= is missing it keeps
       the currently selected size. If the product has no Roast option it
       records the roast as a hidden line-item property instead.

  The grind labels below MUST match GRINDS[].label in the site code verbatim,
  and the roast option values MUST match ROASTS[].optionValue — otherwise the
  deep link stops matching and pick tickets disagree with the catalog.

  Install (Prestige 11.x — Maestrooo; also works on Impact):
    1. Online Store → Themes → ⋯ → Edit code → snippets → New file →
       roast-grind-picker.liquid → paste this file.
    2. Open snippets/product-info.liquid, find   {%- when 'buy_buttons' -%}
       and add on the line ABOVE   {%- render 'buy-buttons', ... -%}:
           {%- unless product.options contains 'Grind size' -%}{%- render 'roast-grind-picker', product: product, form_id: product_form_id -%}{%- endunless -%}
       Prestige keeps the <form> element separate from the blocks and links
       inputs to it with a form="" attribute, so pass form_id — every input
       below carries it and posts with the add-to-cart wherever it renders.
       The `unless` guard is deliberate: as of 2026-09-09 every LAB product
       still carries the legacy options  Bag Size × Grind size (Pour Over /
       Espresso / Whole Bean) = 12 variants, no SKUs.  Rendering this picker
       next to a native grind dropdown gives the customer two grind choices,
       so the snippet stays dormant per product until that product is
       re-imported without a "Grind size" option — then it switches on by
       itself, no theme edit needed.
    3. Save, open any LAB product with ?grind=Coarse and confirm "Coarse" is
       pre-selected and shows in the cart as "Grind: Coarse".

  INSTALLED on the live Prestige theme (id 187587756216) 2026-09-09 — both
  the snippet file and the guarded render line in product-info.liquid.

  Property naming: "Grind" (no leading underscore) is VISIBLE to the customer
  in cart + confirmation email — deliberate, it confirms we read the order.
{%- endcomment -%}

{%- liquid
  assign grind_labels = 'Whole Bean,Extra Coarse,Coarse,Medium-Coarse,Medium,Medium-Fine,Fine,Extra Fine' | split: ','
  assign grind_microns = 'unground,~1200 µm,~900 µm,~700 µm,~600 µm,~450 µm,~300 µm,~150 µm' | split: ','
  assign grind_brews = 'I grind my own,Cold Brew · Cowboy,French Press · Percolator,Chemex · Clever,Drip · Auto Brewer,V60 · AeroPress,Espresso · Moka Pot,Turkish' | split: ','

  assign roast_option_index = -1
  assign size_option_index = -1
  for option in product.options_with_values
    if option.name == 'Roast'
      assign roast_option_index = forloop.index0
    endif
    if option.name == 'Bag Size'
      assign size_option_index = forloop.index0
    endif
  endfor
-%}

<div class="drevil-grind" data-drevil-grind data-roast-option-index="{{ roast_option_index }}" data-size-option-index="{{ size_option_index }}" data-current-variant="{{ product.selected_or_first_available_variant.id }}">
  <div class="drevil-grind__head">
    <span class="drevil-grind__eyebrow">02 — Select grind</span>
    <span class="drevil-grind__spec" data-grind-spec>unground</span>
  </div>

  <div class="drevil-grind__options" role="radiogroup" aria-label="Grind size">
    {%- for label in grind_labels -%}
      {%- assign i = forloop.index0 -%}
      <label class="drevil-grind__opt">
        <input
          type="radio"
          name="properties[Grind]"
          value="{{ label }}"
          data-microns="{{ grind_microns[i] }}"
          {% if form_id %}form="{{ form_id }}"{% endif %}
          {% if forloop.first %}checked{% endif %}
        >
        <span class="drevil-grind__opt-inner">
          <span class="drevil-grind__label">{{ label }}</span>
          <span class="drevil-grind__brew">{{ grind_brews[i] }}</span>
        </span>
      </label>
    {%- endfor -%}
  </div>

  {%- comment -%} Filled from ?brew= by the script below; harmless when empty. {%- endcomment -%}
  <input type="hidden" name="properties[Brew Method]" value="" data-brew-property {% if form_id %}form="{{ form_id }}"{% endif %} disabled>

  {%- comment -%}
    Pre-import fallback: while the product has no "Roast" option, carry the
    roast the customer chose on drevil.coffee as a property. The script
    enables this input only when the roast could NOT be resolved to a variant.
  {%- endcomment -%}
  <input type="hidden" name="properties[Roast]" value="" data-roast-property {% if form_id %}form="{{ form_id }}"{% endif %} disabled>

  <p class="drevil-grind__note">
    Roasted, ground and sealed to order. Nothing sits on a shelf.
  </p>

  <script type="application/json" data-drevil-variants>
    {{ product.variants | json }}
  </script>
</div>

<style>
  .drevil-grind { margin: 1.75rem 0; }
  .drevil-grind__head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .drevil-grind__eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgb(115 115 115);
  }
  .drevil-grind__spec {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; color: rgb(140 140 140);
  }
  .drevil-grind__options {
    display: grid; gap: 0.5rem; grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 750px) {
    .drevil-grind__options { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .drevil-grind__opt { display: block; cursor: pointer; position: relative; }
  .drevil-grind__opt input {
    position: absolute; opacity: 0; width: 0; height: 0;
  }
  .drevil-grind__opt-inner {
    display: block; padding: 0.6rem 0.7rem;
    border: 1px solid rgba(128, 128, 128, 0.35);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .drevil-grind__opt:hover .drevil-grind__opt-inner {
    border-color: rgba(128, 128, 128, 0.6);
  }
  .drevil-grind__opt input:checked + .drevil-grind__opt-inner {
    border-color: rgb(220 38 38); background: rgba(220, 38, 38, 0.07);
  }
  /* keyboard focus must stay visible — Maestrooo themes strip outlines aggressively */
  .drevil-grind__opt input:focus-visible + .drevil-grind__opt-inner {
    outline: 2px solid rgb(220 38 38); outline-offset: 2px;
  }
  .drevil-grind__label {
    display: block; font-size: 0.8rem; font-weight: 500; line-height: 1.2;
  }
  .drevil-grind__brew {
    display: block; margin-top: 0.15rem; font-size: 0.68rem; opacity: 0.62;
  }
  .drevil-grind__note {
    margin-top: 0.7rem; font-size: 0.72rem; opacity: 0.6;
  }
</style>

<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var wantGrind = params.get('grind');
    var wantBrew = params.get('brew');
    var wantRoast = params.get('roast');
    var wantSize = params.get('size');

    document.querySelectorAll('[data-drevil-grind]').forEach(function (root) {
      var spec = root.querySelector('[data-grind-spec]');
      var brewInput = root.querySelector('[data-brew-property]');
      var roastInput = root.querySelector('[data-roast-property]');

      function syncSpec() {
        var checked = root.querySelector('input[name="properties[Grind]"]:checked');
        if (checked && spec) spec.textContent = checked.getAttribute('data-microns') || '';
      }

      root.addEventListener('change', function (e) {
        if (e.target && e.target.name === 'properties[Grind]') syncSpec();
      });

      /* ---- ?grind= : pre-select the matching radio (exact label match) ---- */
      if (wantGrind) {
        var radio = Array.prototype.find.call(
          root.querySelectorAll('input[name="properties[Grind]"]'),
          function (r) { return r.value === wantGrind; }
        );
        if (radio) { radio.checked = true; syncSpec(); }
      }

      /* ---- ?brew= : carry the brew method on the line ---- */
      if (wantBrew && brewInput) {
        brewInput.value = wantBrew;
        brewInput.disabled = false;
      }

      /* ---- ?roast= / ?size= : swap to the Roast x Bag Size variant ---- */
      if (wantRoast || wantSize) {
        var optIdx = parseInt(root.getAttribute('data-roast-option-index'), 10);
        var sizeIdx = parseInt(root.getAttribute('data-size-option-index'), 10);
        var variants = [];
        try {
          variants = JSON.parse(root.querySelector('[data-drevil-variants]').textContent);
        } catch (err) { /* leave empty */ }

        var norm = function (x) { return String(x || '').trim().toLowerCase(); };
        var current = variants.find(function (v) {
          return String(v.id) === (params.get('variant') || root.getAttribute('data-current-variant'));
        }) || variants[0];
        // Missing param = keep whatever the page already has for that option.
        var roastWanted = wantRoast || (current && optIdx >= 0 ? current.options[optIdx] : '');
        var sizeWanted = wantSize || (current && sizeIdx >= 0 ? current.options[sizeIdx] : '');

        var match = null;
        if (optIdx >= 0 || sizeIdx >= 0) {
          match = variants.find(function (v) {
            var o = v.options || [];
            if (optIdx >= 0 && norm(o[optIdx]) !== norm(roastWanted)) return false;
            if (sizeIdx >= 0 && norm(o[sizeIdx]) !== norm(sizeWanted)) return false;
            return true;
          });
        }

        if (match) {
          // Only redirect once, and only if the page is not already on it.
          if (String(params.get('variant')) !== String(match.id)) {
            params.set('variant', match.id);
            window.location.replace(
              window.location.pathname + '?' + params.toString() + window.location.hash
            );
          }
        }
        if (wantRoast && optIdx < 0 && roastInput) {
          // Roast variants not imported yet — record the intent on the order.
          roastInput.value = wantRoast;
          roastInput.disabled = false;
        }
      }
    });
  })();
</script>
